#!/usr/bin/make -f
export LC_ALL=C.UTF-8
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1

%:
	dh $@

override_dh_auto_configure:
	@true

override_dh_auto_build:
	bash packaging/publish-gui.sh "$(CURDIR)/build/publish"

override_dh_auto_install:
	bash packaging/stage-package.sh --publish-dir "$(CURDIR)/build/publish" --destdir "$(CURDIR)/debian/damx"

override_dh_auto_clean:
	rm -rf "$(CURDIR)/build"
	dh_auto_clean

override_dh_auto_test:
	@true

override_dh_installsystemd:
	@# Units are enabled/restarted from the maintainer scripts.
	@true

# Never modify the bundled .NET runtime/native libraries: strip/DWARF tools
# can corrupt or slow down a self-contained publish, and dpkg-shlibdeps cannot
# resolves private CoreCLR libraries (libcoreclrtraceptprovider.so etc.).
override_dh_strip:
	@true

override_dh_dwz:
	@true

override_dh_makeshlibs:
	@true

override_dh_shlibdeps:
	@# Dependencies are declared manually in debian/control.
	@true
