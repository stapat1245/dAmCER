<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DivAcerManagerMax.InternalsManager"
        Width="620" Height="720"
        Title="DAMX Internals Manager"
        Icon="iconTransparent.png"
        WindowStartupLocation="CenterOwner"
        Background="#0B0B0F"
        FontFamily="{StaticResource OpenSansFont}">

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Margin="24,22,24,14" Spacing="2">
            <TextBlock Text="Internals manager" Classes="H1" />
            <TextBlock Text="Driver parameters, model overrides and debug tools"
                       Classes="Caption" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="24,0,24,24">
            <StackPanel>

                <Border Classes="Card">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Developer mode" Classes="H2" />
                                <TextBlock Text="Reveal controls for features the daemon did not detect."
                                           Classes="Dim" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="DevModeToggleSwitch" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Click="DevModeSwitch_OnClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Load drivers with parameters" Classes="H2" />
                            <TextBlock Text="One-shot parameters applied on the next driver reload."
                                       Classes="Dim" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="ForceNitroButton" Classes="Ghost" Content="nitro_v4"
                                    Click="ForceNitroButton_OnClick" Margin="0,0,10,0" />
                            <Button x:Name="ForcePredatorButton" Classes="Ghost" Content="predator_v4"
                                    Click="ForcePredatorButton_OnClick" Margin="0,0,10,0" />
                            <Button x:Name="ForceEnableAll" Classes="Ghost" Content="enable_all"
                                    Click="ForceEnableAll_OnClick" />
                        </WrapPanel>

                        <TextBlock Text="Parameters are cleared after a restart unless made permanent below."
                                   Classes="Caption" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Permanent model override" Classes="H2" />
                            <TextBlock Text="Force a model profile for unsupported or misdetected devices."
                                       Classes="Dim" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>

                        <ComboBox x:Name="ForceParameterPermanentlyComboBox" SelectedIndex="0"
                                  SelectionChanged="ForceParameterPermanently_OnSelectionChanged"
                                  HorizontalAlignment="Left" MinWidth="300">
                            <ComboBoxItem Content="Disabled" />
                            <ComboBoxItem Content="Force Predator model (predator_v4)" />
                            <ComboBoxItem Content="Force Nitro model (nitro_v4)" />
                            <ComboBoxItem Content="Force all features (enable_all)" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Restart controls" Classes="H2" />
                            <TextBlock Text="Apply changes by restarting system components."
                                       Classes="Dim" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="RestartSuiteButton" Classes="DangerGhost"
                                    Content="Restart drivers + daemon"
                                    Click="RestartSuiteButton_OnClick" Margin="0,0,10,0" />
                            <Button x:Name="RestartDaemon" Classes="Ghost" Content="Restart daemon only"
                                    Click="RestartDaemon_OnClick" />
                        </WrapPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="• Drivers + daemon: full reset, clears all parameters."
                                       Classes="Caption" />
                            <TextBlock Text="• Daemon only: re-reads the feature set with current parameters."
                                       Classes="Caption" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="Card" Margin="0">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Debug tools" Classes="H2" />
                            <TextBlock Text="Open the daemon log in your default editor."
                                       Classes="Dim" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button x:Name="DaemonLogsButton" Classes="Ghost" Content="View daemon log"
                                HorizontalAlignment="Left" Click="DaemonLogsButton_OnClick" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
