<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DivAcerManagerMax.Dashboard"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:divAcerManagerMax="clr-namespace:DivAcerManagerMax"
             xmlns:avalonia="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:DataType="divAcerManagerMax:Dashboard">

    <ScrollViewer>
        <Grid Margin="24,20,24,24" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="2*,*" RowSpacing="14"
              ColumnSpacing="14">

            <!-- ============ Header ============ -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Overview" Classes="Display" />
                    <TextBlock x:Name="HeaderModelText" Classes="Muted" FontSize="12"
                               Text="{Binding ModelText}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border x:Name="PowerSourceChip" Classes="Well" Padding="12,7" CornerRadius="999">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon x:Name="PowerSourceIcon" Kind="PowerPlugOutline" Width="15"
                                                   Height="15" Foreground="{Binding PowerSourceBrush}" />
                            <TextBlock Text="{Binding PowerSourceText}" FontSize="12"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============ Metric tiles ============ -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="14">

                <!-- CPU -->
                <Border Grid.Column="0" Classes="Card" Margin="0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="Cpu64Bit" Width="16" Height="16" />
                                <TextBlock Text="Processor" Classes="H2" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="Well" Padding="8,3" CornerRadius="999">
                                <TextBlock Text="{Binding CpuTempBadge}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding CpuTempBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding CpuModel}" Classes="Dim" FontSize="11"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Temperature" Classes="Label" />
                                <TextBlock Grid.Column="1" Text="{Binding CpuTempText}" Classes="MetricSmall" />
                            </Grid>
                            <ProgressBar Value="{Binding CpuTempValue}" Maximum="105"
                                         Foreground="{Binding CpuTempBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Load" Classes="Label" />
                                <TextBlock Grid.Column="1" Text="{Binding CpuUsageText}" Classes="Value" />
                            </Grid>
                            <ProgressBar Value="{Binding CpuUsageValue}" Maximum="100" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="Frequency" Classes="Caption" />
                                <TextBlock Text="{Binding CpuFreqText}" Classes="Value" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Text="Package power" Classes="Caption" />
                                <TextBlock Text="{Binding CpuPowerText}" Classes="Value" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Grid.Column="1" Classes="Card" Margin="0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="Gpu" Width="16" Height="16" />
                                <TextBlock Text="Graphics" Classes="H2" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="Well" Padding="8,3" CornerRadius="999">
                                <TextBlock Text="{Binding GpuTempBadge}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding GpuTempBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding GpuModel}" Classes="Dim" FontSize="11"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Temperature" Classes="Label" />
                                <TextBlock Grid.Column="1" Text="{Binding GpuTempText}" Classes="MetricSmall" />
                            </Grid>
                            <ProgressBar Value="{Binding GpuTempValue}" Maximum="105"
                                         Foreground="{Binding GpuTempBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Load" Classes="Label" />
                                <TextBlock Grid.Column="1" Text="{Binding GpuUsageText}" Classes="Value" />
                            </Grid>
                            <ProgressBar Value="{Binding GpuUsageValue}" Maximum="100" />
                        </StackPanel>

                        <StackPanel Spacing="5" IsVisible="{Binding VramVisible}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="VRAM" Classes="Label" />
                                <TextBlock Grid.Column="1" Text="{Binding VramText}" Classes="Value" />
                            </Grid>
                            <ProgressBar Value="{Binding VramValue}" Maximum="100" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="Clock" Classes="Caption" />
                                <TextBlock Text="{Binding GpuFreqText}" Classes="Value" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Text="Power draw" Classes="Caption" />
                                <TextBlock Text="{Binding GpuPowerText}" Classes="Value" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Memory -->
                <Border Grid.Column="2" Classes="Card" Margin="0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="Memory" Width="16" Height="16" />
                                <TextBlock Text="Memory" Classes="H2" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="System RAM" Classes="Dim" FontSize="11" />

                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="In use" Classes="Label" />
                                <TextBlock Grid.Column="1" Text="{Binding RamUsageText}" Classes="MetricSmall" />
                            </Grid>
                            <ProgressBar Value="{Binding RamUsageValue}" Maximum="100" />
                        </StackPanel>

                        <StackPanel Spacing="4" Margin="0,2,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Installed" Classes="Caption" />
                                <TextBlock Grid.Column="1" Text="{Binding RamTotalText}" Classes="Value" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="OS" Classes="Caption" />
                                <TextBlock Grid.Column="1" Text="{Binding OsText}" Classes="Value" FontSize="12"
                                           TextTrimming="CharacterEllipsis" MaxWidth="150" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Kernel" Classes="Caption" />
                                <TextBlock Grid.Column="1" Text="{Binding KernelText}" Classes="Value" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Cooling -->
                <Border Grid.Column="3" Classes="Card" Margin="0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="Fan" Width="16" Height="16" />
                                <TextBlock Text="Cooling" Classes="H2" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding FanModeText}" Classes="Dim" FontSize="11" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <StackPanel Grid.Column="0" Spacing="6" HorizontalAlignment="Center">
                                <material:MaterialIcon x:Name="CpuFanIcon" Kind="Fan" Width="44" Height="44"
                                                       RenderTransformOrigin="50%,50%"
                                                       HorizontalAlignment="Center" />
                                <TextBlock Text="CPU fan" Classes="Caption" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding CpuFanText}" Classes="Value"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Center">
                                <material:MaterialIcon x:Name="GpuFanIcon" Kind="Fan" Width="44" Height="44"
                                                       RenderTransformOrigin="50%,50%"
                                                       HorizontalAlignment="Center" />
                                <TextBlock Text="GPU fan" Classes="Caption" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding GpuFanText}" Classes="Value"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding FanSourceText}" Classes="Caption" TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Live charts + battery ============ -->
            <Border Grid.Row="2" Grid.Column="0" Classes="Card" Margin="0">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="ChartLine" Width="16" Height="16" />
                            <TextBlock Text="Live monitoring" Classes="H2" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="ChartTempButton" Classes="Chip" Content="Temperature"
                                    Click="ChartTempButton_OnClick" />
                            <Button x:Name="ChartUsageButton" Classes="Chip" Content="Load"
                                    Click="ChartUsageButton_OnClick" />
                            <Button x:Name="ChartFanButton" Classes="Chip" Content="Fans"
                                    Click="ChartFanButton_OnClick" />
                        </StackPanel>
                    </Grid>

                    <avalonia:CartesianChart x:Name="LiveChart" MinHeight="240" VerticalAlignment="Stretch" />

                    <TextBlock x:Name="ChartHintText" Classes="Caption"
                               Text="Two-second refresh · last 2 minutes" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="1" Classes="Card" Margin="0" IsVisible="{Binding HasBattery}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="Battery70" Width="16" Height="16" />
                        <TextBlock Text="Battery" Classes="H2" />
                    </StackPanel>

                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding BatteryPercentText}" Classes="Display" HorizontalAlignment="Center" />
                        <ProgressBar Value="{Binding BatteryPercentValue}" Maximum="100" Width="200" />
                        <TextBlock Text="{Binding BatteryStatusText}" Classes="Muted" FontSize="12"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="6" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Remaining" Classes="Caption" />
                            <TextBlock Grid.Column="1" Text="{Binding BatteryTimeText}" Classes="Value" FontSize="12" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Health" Classes="Caption" />
                            <TextBlock Grid.Column="1" Text="{Binding BatteryHealthText}" Classes="Value"
                                       FontSize="12" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Cycles" Classes="Caption" />
                            <TextBlock Grid.Column="1" Text="{Binding BatteryCyclesText}" Classes="Value"
                                       FontSize="12" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Draw" Classes="Caption" />
                            <TextBlock Grid.Column="1" Text="{Binding BatteryPowerText}" Classes="Value"
                                       FontSize="12" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Quick actions ============ -->
            <Border Grid.Row="3" Grid.Column="0" Classes="Card" Margin="0">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="LightningBolt" Width="16" Height="16" />
                            <TextBlock Text="Quick performance profiles" Classes="H2" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentProfileText}" Classes="Caption"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding ProfileHintText}" Classes="Dim" FontSize="11" TextWrapping="Wrap" />
                    <StackPanel x:Name="ProfileChipsPanel" Orientation="Horizontal" />

                    <Border Classes="Hairline" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <TextBlock Text="Cooling mode" Classes="Label" VerticalAlignment="Center" />
                        <StackPanel x:Name="FanModeChipsPanel" Grid.Column="1" Orientation="Horizontal" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Grid.Column="1" Classes="Card" Margin="0">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="InformationOutline" Width="16" Height="16" />
                        <TextBlock Text="Device" Classes="H2" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Model" Classes="Caption" />
                            <TextBlock Grid.Column="1" Text="{Binding ModelText}" Classes="Value" FontSize="12"
                                       TextTrimming="CharacterEllipsis" MaxWidth="180" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Daemon" Classes="Caption" />
                            <TextBlock Grid.Column="1" Text="{Binding DaemonVersionText}"
                                       Classes="Value" FontSize="12" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Driver" Classes="Caption" />
                            <TextBlock Grid.Column="1" Text="{Binding DriverVersionText}" Classes="Value"
                                       FontSize="12" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Features" Classes="Caption" />
                            <TextBlock Grid.Column="1" Text="{Binding FeatureCountText}" Classes="Value"
                                       FontSize="12" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
